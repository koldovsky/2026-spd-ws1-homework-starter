{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck *)",
      "Bash(npm run build)",
      "Bash(npx vitest run *)",
      "Bash(node docs/ai/hook-cases.mjs)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run typecheck *)",
      "PowerShell(npm run build)",
      "PowerShell(npx vitest run *)",
      "PowerShell(node docs/ai/hook-cases.mjs)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm uninstall *)",
      "Bash(npm run db:reset)",
      "Bash(npm run db:reset *)",
      "Bash(node scripts/db-reset.mjs*)",
      "PowerShell(git push *)",
      "PowerShell(git commit *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm ci *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npm run db:reset)",
      "PowerShell(npm run db:reset *)",
      "PowerShell(node scripts/db-reset.mjs*)",
      "Edit(./package.json)",
      "Edit(./package-lock.json)",
      "Edit(./.claude/**)",
      "Edit(./AGENTS.md)",
      "Edit(./.github/**)",
      "Edit(./next.config.ts)",
      "Edit(./lib/db.ts)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./data/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./data/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm --recursive *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -f*)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(rm * -Recurse*)",
      "PowerShell(rm -r *)",
      "PowerShell(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migrations.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-migrations-diff.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
