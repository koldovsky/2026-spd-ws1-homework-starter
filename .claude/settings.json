{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migrations.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(npm run db:reset)",
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./AGENTS.md)",
      "Write(./AGENTS.md)",
      "Edit(./.github/CODEOWNERS)",
      "Write(./.github/CODEOWNERS)"
    ],
    "allow": [
      "Bash(npm test)",
      "Bash(npm run typecheck)"
    ]
  }
}
