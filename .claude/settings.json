{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./secrets/**)", "Bash(git reset --hard*)"],
    "ask": ["Bash(git push*)", "Bash(npm run db:reset*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migrations.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
