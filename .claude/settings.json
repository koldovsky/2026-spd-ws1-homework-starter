{
  "_comment": "owner: @vvfesik · why: enforce team agreement L0 (migration immutability via PreToolUse hook) and secrets/permissions rows (env deny, destructive ask) · review-by: 2027-02-25",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)"
    ],
    "ask": [
      "Bash(npm run db:reset*)",
      "Bash(git push*)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/no-migration-edits.mjs"
          }
        ]
      }
    ]
  }
}
